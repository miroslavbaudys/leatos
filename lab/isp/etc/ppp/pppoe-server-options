# pppd options for the lab ISP's PPPoE sessions (pppoe-server -O). The
# ISP's /init adds require-pap, require-chap or noauth (lab_pppoe=pap|chap|none).
lcp-echo-interval 10
lcp-echo-failure 3
ms-dns 203.0.113.1
mtu 1492
mru 1492
noccp
novj
nodefaultroute
# Offer IPv6CP too: leatos logs the offer and answers with an LCP
# Protocol-Reject (until M7). lab_pppoe_ipv6=0 removes this line.
+ipv6
debug
logfile /tmp/pppd.log
