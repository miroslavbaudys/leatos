#!/usr/bin/busybox sh
# rrouter lab "ISP": PID 1 of the ISP VM, on the router's WAN link.
#   eth0 203.0.113.1/24 — DHCP server (udhcpd) for the router's WAN,
#   web server (httpd, with CGI helpers), DNS server (dnsd: isp.example,
#   behind a cacheless dnsmasq that adds big.isp.example: lab-dns),
#   TCP byte sink on port 5001 (tcpsvd + wc), NTP server (busybox ntpd -l:
#   without peers it serves its own clock, i.e. the host's, as stratum 1).
# lab_vlan=N on the kernel command line (scripts/lab-test.sh LAB_VLAN=N):
#   all of this on eth0.N, an 802.1Q-tagged link, as ISPs that require a
#   VLAN; eth0 itself gets no address, so untagged frames reach nothing.
#   8021q comes from modloop-virt, attached as the VM's disk.
# lab_pppoe=pap|chap|none (scripts/lab-test.sh LAB_PPPOE=…): the WAN is a PPPoE
#   access concentrator instead (pppoe-server, AC "isp-ac", service
#   "internet", rp-pppoe's user mode (pppd over a pty, async HDLC:
#   ppp_async from modloop-virt, which has no pppoe module); user rrouter,
#   password lab-secret, PAP or CHAP required, or none), the session gets
#   203.0.113.50 and DNS 203.0.113.1; no DHCP server, so a router not
#   speaking PPPoE gets no address.
# lab_static=1 (scripts/lab-test.sh LAB_WAN_STATIC=1): no DHCP server; the
#   router must use its static WAN address (203.0.113.60).
# /etc/dot/server.pem + server.key (scripts/lab-test.sh LAB_DOT=1 adds them,
#   made per run under a lab CA): DNS over TLS on 203.0.113.1:853, stunnel
#   in front of dnsmasq (TCP on 127.0.0.1:5300) with dnsd's names plus
#   dot.isp.example, which only this server knows (plain.isp.example only
#   dnsd does). Queries are logged as "isp-dot: ...".
bb=/usr/bin/busybox
bx=/usr/bin/busybox-extras
export PATH=/usr/bin:/usr/sbin:/bin:/sbin

$bb mount -t proc proc /proc
$bb mount -t sysfs sysfs /sys
$bb mount -t devtmpfs devtmpfs /dev 2>/dev/null
$bb mkdir -p /tmp /var/lib/udhcpd
for m in failover net_failover virtio_net af_packet; do
  modprobe "$m" 2>/dev/null || $bb modprobe "$m" 2>/dev/null || echo "LAB WARN: modprobe $m failed"
done
$bb hostname isp
$bb ifconfig lo 127.0.0.1 up
IF=eth0
vlan=$($bb sed -n 's/.*lab_vlan=\([0-9]*\).*/\1/p' /proc/cmdline)
pppoe=$($bb sed -n 's/.*lab_pppoe=\([a-z]*\).*/\1/p' /proc/cmdline)
static=$($bb sed -n 's/.*lab_static=\([0-9]*\).*/\1/p' /proc/cmdline)
if [ -n "$vlan" ] || [ -n "$pppoe" ]; then
  for m in virtio_blk squashfs; do modprobe "$m" 2>/dev/null || $bb modprobe "$m" 2>/dev/null; done
  $bb mkdir -p /.modloop
  $bb mount -t squashfs -o ro /dev/vda /.modloop || { echo "LAB FAIL: isp: no modloop disk"; $bb poweroff -f; }
  $bb mount -o bind /.modloop/modules /lib/modules
fi
if [ -n "$vlan" ]; then
  $bb modprobe 8021q || { echo "LAB FAIL: isp: no 8021q module"; $bb poweroff -f; }
  $bb ifconfig eth0 up
  $bb ip link add link eth0 name "eth0.$vlan" type vlan id "$vlan" || { echo "LAB FAIL: isp: cannot add VLAN $vlan"; $bb poweroff -f; }
  IF="eth0.$vlan"
  echo "LAB isp: serving on VLAN $vlan ($IF)"
fi
$bb ifconfig "$IF" 203.0.113.1 netmask 255.255.255.0 up || { echo "LAB FAIL: isp has no $IF"; $bb poweroff -f; }
$bb sed "s/^interface .*/interface $IF/" /etc/udhcpd.conf >/tmp/udhcpd.conf
$bb touch /tmp/udhcpd.leases
$bb dd if=/dev/zero of=/www/5mb bs=1024 count=5120 2>/dev/null   # shaper throughput test
if [ -n "$pppoe" ]; then
  for m in ppp_generic ppp_async; do
    $bb modprobe "$m" || { echo "LAB FAIL: isp: no $m module"; $bb poweroff -f; }
  done
  [ -e /dev/ppp ] || $bb mknod /dev/ppp c 108 0
  $bb mkdir -p /var/run /var/log/ppp /dev/pts
  $bb mount -t devpts devpts /dev/pts   # pppd talks to pppoe over a pty
  # The initrd's files belong to whoever built it: pppd only reads secrets
  # that root owns.
  $bb chown -R 0:0 /etc
  $bb chmod 600 /etc/ppp/pap-secrets /etc/ppp/chap-secrets
  # pppd's log and pppoe-server's syslog messages on the console
  # (scripts/lab-test.sh LAB_VERBOSE=1).
  $bb touch /tmp/pppd.log /tmp/messages
  $bb syslogd -O /tmp/messages
  $bb tail -F /tmp/pppd.log /tmp/messages 2>/dev/null | while IFS= read -r l; do echo "isp-ppp: $l"; done &
  # none: no authentication (ISPs such as O2 CZ); the router has no user name.
  { $bb cat /etc/ppp/pppoe-server-options; if [ "$pppoe" = none ]; then echo noauth; else echo "require-$pppoe"; fi; } >/tmp/pppoe-server-options
  # The session's ISP end shares eth0's address (point to point: the
  # peer gets a /32 route over ppp0).
  /usr/sbin/pppoe-server -I "$IF" -q /usr/sbin/lab-pppd -L 203.0.113.1 -R 203.0.113.50 -N 4 \
    -C isp-ac -S internet -O /tmp/pppoe-server-options \
    || { echo "LAB FAIL: isp: pppoe-server did not start"; $bb poweroff -f; }
  echo "LAB isp: PPPoE access concentrator ($pppoe) on $IF"
elif [ -n "$static" ]; then
  echo "LAB isp: no DHCP server (static WAN)"
else
  $bx udhcpd -S /tmp/udhcpd.conf
fi
$bx httpd -p 80 -h /www
# Long single-connection upload sink (ECN/AQM check): replies with the byte count.
$bx tcpsvd -E 0.0.0.0 5001 $bb wc -c &
# dnsd, and with DNS over TLS dnsmasq behind stunnel (lab-dns; the client
# stops and restarts them through cgi-bin/dns for its serve-stale check).
if [ -f /etc/dot/server.pem ]; then
  { $bb grep -v '^plain\.' /etc/dnsd.conf | $bb awk '{ print $2, $1 }'; echo "203.0.113.53 dot.isp.example"; } >/tmp/dot-hosts
  $bb touch /tmp/dot.log
fi
/usr/sbin/lab-dns start || { echo "LAB FAIL: isp: dnsmasq did not start"; $bb poweroff -f; }
if [ -f /etc/dot/server.pem ]; then
  $bb printf 'foreground = no\npid = /tmp/stunnel.pid\noutput = /tmp/dot.log\n[dot]\naccept = 203.0.113.1:853\nconnect = 127.0.0.1:5300\ncert = /etc/dot/server.pem\nkey = /etc/dot/server.key\n' >/tmp/stunnel.conf
  /usr/bin/stunnel /tmp/stunnel.conf || { echo "LAB FAIL: isp: stunnel did not start"; $bb poweroff -f; }
  $bb tail -F /tmp/dot.log 2>/dev/null | while IFS= read -r l; do echo "isp-dot: $l"; done &
  echo "LAB isp: DNS over TLS on 203.0.113.1:853"
fi
$bb ntpd -n -l &
echo "LAB isp ready"
while :; do $bb sleep 3600; done
