#!/usr/bin/busybox sh
# rrouter lab "ISP": PID 1 of the ISP VM, on the router's WAN link.
#   eth0 203.0.113.1/24 — DHCP server (udhcpd) for the router's WAN,
#   web server (httpd, with CGI helpers), DNS server (dnsd: isp.example),
#   TCP byte sink on port 5001 (tcpsvd + wc), NTP server (busybox ntpd -l:
#   without peers it serves its own clock, i.e. the host's, as stratum 1).
bb=/usr/bin/busybox
bx=/usr/bin/busybox-extras
export PATH=/usr/bin:/usr/sbin:/bin:/sbin

$bb mount -t proc proc /proc
$bb mount -t sysfs sysfs /sys
$bb mount -t devtmpfs devtmpfs /dev 2>/dev/null
$bb mkdir -p /tmp /var/lib/udhcpd
for m in failover net_failover virtio_net af_packet; do
  modprobe "$m" 2>/dev/null || $bb modprobe "$m" 2>/dev/null || echo "LAB WARN: modprobe $m failed"
done
$bb hostname isp
$bb ifconfig lo 127.0.0.1 up
$bb ifconfig eth0 203.0.113.1 netmask 255.255.255.0 up || { echo "LAB FAIL: isp has no eth0"; $bb poweroff -f; }
$bb touch /tmp/udhcpd.leases
$bb dd if=/dev/zero of=/www/5mb bs=1024 count=5120 2>/dev/null   # shaper throughput test
$bx udhcpd -S /etc/udhcpd.conf
$bx httpd -p 80 -h /www
# Long single-connection upload sink (ECN/AQM check): replies with the byte count.
$bx tcpsvd -E 0.0.0.0 5001 $bb wc -c &
$bx dnsd -c /etc/dnsd.conf -i 203.0.113.1 &
$bb ntpd -n -l &
echo "LAB isp ready"
while :; do $bb sleep 3600; done
