#!/usr/bin/busybox sh
# Port forward check: fetch http://<caller>:<port>/ back through the
# caller's address (the router's WAN address after NAT), so the request
# arrives at the router from the internet. Query string: the port.
bb=/usr/bin/busybox
addr=${REMOTE_ADDR#\[}; addr=${addr%\]}; addr=${addr#::ffff:}
port=$(echo "$QUERY_STRING" | $bb tr -cd '0-9')
echo "Content-Type: text/plain"
echo
body=$($bb wget -q -T 4 -O - "http://$addr:${port:-8080}/" 2>/dev/null)
if [ -n "$body" ]; then echo "fetch=OK via $addr:$port: $(echo "$body" | $bb head -c 60)"; else echo "fetch=FAILED via $addr:$port"; fi
