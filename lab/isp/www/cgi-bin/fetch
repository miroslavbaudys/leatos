#!/usr/bin/busybox sh
# Port forward check: fetch http://<caller>:<port>/ back through the
# caller's address (the router's WAN address after NAT), so the request
# arrives at the router from the internet. Query string: the port, then
# optionally &to=ADDR (IPv6: another address of the caller, the pinhole
# check of scripts/lab-test.sh LAB_IPV6).
bb=/usr/bin/busybox
addr=${REMOTE_ADDR#\[}; addr=${addr%\]}; addr=${addr#::ffff:}
port=$(echo "${QUERY_STRING%%&*}" | $bb tr -cd '0-9')
to=$(echo "$QUERY_STRING" | $bb sed -n 's/.*&to=\([0-9a-fA-F:]*\).*/\1/p')
[ -n "$to" ] && addr=$to
echo "Content-Type: text/plain"
echo
host=$addr
case "$addr" in *:*) host="[$addr]" ;; esac # IPv6: not translated, the caller itself
body=$($bb wget -q -T 4 -O - "http://$host:${port:-8080}/" 2>/dev/null)
if [ -n "$body" ]; then echo "fetch=OK via $addr:$port: $(echo "$body" | $bb head -c 60)"; else echo "fetch=FAILED via $addr:$port"; fi
