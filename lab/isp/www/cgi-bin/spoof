#!/usr/bin/busybox sh
# Anti-spoofing check: open a connection to the caller's address (the
# router's WAN address after NAT) :PORT with a forged source in the
# router's main LAN, 192.168.1.77, as anyone on the internet could. The
# router must drop it before its port forward takes it (drop reason
# "spoofed"); the client compares the router's counters. Never answered
# either way (the forward's target replies to .77 on its own network).
# The source comes from a host route's src hint, removed again; ARP keeps
# using our real address (arp_announce 2). Query string: the port, then
# optionally &src=a.b.c.d (another forged source, e.g. a subnet routed
# behind a LAN router: scripts/lab-test.sh LAB_ROUTES).
bb=/usr/bin/busybox
addr=${REMOTE_ADDR#\[}; addr=${addr%\]}; addr=${addr#::ffff:}
port=$(echo "${QUERY_STRING%%&*}" | $bb tr -cd '0-9')
src=$(echo "$QUERY_STRING" | $bb sed -n 's/.*&src=\([0-9.]*\).*/\1/p')
src=${src:-192.168.1.77}
echo "Content-Type: text/plain"
echo
dev=$($bb ip route get "$addr" | $bb sed -n 's/.* dev \([^ ]*\).*/\1/p')
ann=/proc/sys/net/ipv4/conf/$dev/arp_announce
a0=$($bb cat "$ann")
echo 2 >"$ann"
# Over PPPoE (ppp0) the peer already has a /32 route: replaced for the
# probe, then restored with its own source.
orig=$($bb ip route get "$addr" | $bb sed -n 's/.* src \([^ ]*\).*/\1/p')
restore=""
if $bb ip addr add "$src/32" dev "$dev"; then
  if $bb ip route add "$addr/32" dev "$dev" src "$src" 2>/dev/null; then
    ok=1; restore=del
  elif $bb ip route replace "$addr/32" dev "$dev" src "$src"; then
    ok=1; restore=back
  fi
fi
$bb wget -q -T 3 -O /dev/null "http://$addr:${port:-8080}/" >/dev/null 2>&1
case "$restore" in
  del) $bb ip route del "$addr/32" dev "$dev" src "$src" 2>/dev/null ;;
  back) $bb ip route replace "$addr/32" dev "$dev" scope link src "$orig" ;;
esac
$bb ip addr del "$src/32" dev "$dev" 2>/dev/null
echo "$a0" >"$ann"
if [ -n "$ok" ]; then echo "spoof=SENT from $src to $addr:$port on $dev"; else echo "spoof=FAILED on $dev"; fi
