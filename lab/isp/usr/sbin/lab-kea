#!/usr/bin/busybox sh
# Kea's DHCPv6 server for prefix delegation (scripts/lab-test.sh LAB_IPV6,
# docs/ipv6.md step 3): lab-kea start IF POOL (a /48 delegated as /56s,
# leases not kept, renew 10 s) | stop.
bb=/usr/bin/busybox
case "$1" in
  start)
    echo "$2" >/tmp/kea-if
    echo "$3" >/tmp/kea-pool
    $bb mkdir -p /run/kea /var/lib/kea /run/lock/kea /var/run/kea
    $bb cat >/tmp/kea-dhcp6.conf <<EOF
{ "Dhcp6": {
  "interfaces-config": { "interfaces": [ "$2" ], "service-sockets-max-retries": 20, "service-sockets-retry-wait-time": 1000 },
  "lease-database": { "type": "memfile", "persist": false },
  "renew-timer": 10, "rebind-timer": 20, "preferred-lifetime": 60, "valid-lifetime": 120,
  "subnet6": [ { "id": 1, "subnet": "2001:db8:ffff::/64", "interface": "$2",
    "pd-pools": [ { "prefix": "$3", "prefix-len": 48, "delegated-len": 56 } ],
    "option-data": [ { "name": "dns-servers", "data": "2001:db8:ffff::1" } ] } ],
  "loggers": [ { "name": "kea-dhcp6", "output-options": [ { "output": "stdout" } ], "severity": "INFO" } ]
} }
EOF
    /usr/sbin/kea-dhcp6 -c /tmp/kea-dhcp6.conf >>/tmp/kea.out 2>&1 &
    echo $! >/tmp/kea.pid
    echo "LAB isp: kea delegating $3/48 as /56s on $2"
    ;;
  stop)
    [ -f /tmp/kea.pid ] && $bb kill "$($bb cat /tmp/kea.pid)" 2>/dev/null
    $bb sleep 1
    $bb rm -f /tmp/kea.pid /run/kea/*.pid /run/lock/kea/* 2>/dev/null
    ;;
esac
